# Copy to `.env` in the project root (never commit `.env`).
# Loaded by app.config.js via dotenv and by Expo for EXPO_PUBLIC_*.

# Firebase JS SDK — must match a Firebase app in the same project as google-services.json / GoogleService-Info.plist.
# Map: Firebase Console → Project settings → Your apps.
# - `EXPO_PUBLIC_FIREBASE_APP_ID`: prefer the Web app’s `appId` (`1:…:web:…`). Android/iOS ids sometimes work for RN but Web is the supported choice.
# - `EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID`: optional; from Web app if you use Analytics.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Realtime Database URL (Firebase Console → Build → Realtime Database → URL)
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Google Sign-In (Android) — Web client ID from Firebase Console → Authentication → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat SDK public keys (not secret keys). Test Store keys often use the `test_` prefix.
# `configureRevenueCat` uses Apple key on iOS and Google key on Android — set both for local runs on either platform.
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=

# Optional entitlement identifier overrides (usually leave unset to use app.json)
# REVENUECAT_ENTITLEMENT_PRO=
# REVENUECAT_ENTITLEMENT_WOODEN=
# REVENUECAT_ENTITLEMENT_FIBERGLASS=
# REVENUECAT_ENTITLEMENT_LIFETIME=

EXPO_PUBLIC_CLOUD_FUNCTIONS_REGION=asia-east2

# Sentry crash reporting (public DSN — safe in client). Source map upload uses SENTRY_AUTH_TOKEN in EAS secrets.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog funnel analytics (project API key — safe in client). Server uses POSTHOG_API_KEY in functions env.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
