{
  "expo": {
    "name": "Into the Pond",
    "slug": "into-the-pond-v3",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intothepond",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intothepond.app.v3",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.intothepond.app.v3",
      "versionCode": 1,
      "googleServicesFile": "./assets/google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-frames/splash-frame.png",
          "resizeMode": "cover",
          "backgroundColor": "#BEC4B3",
          "ios": {
            "image": "./assets/images/splash-frames/splash-frame.png",
            "resizeMode": "cover",
            "backgroundColor": "#BEC4B3",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/images/splash-frames/splash-frame.png",
            "mdpi": "./assets/images/splash-frames/splash-frame.png",
            "hdpi": "./assets/images/splash-frames/splash-frame.png",
            "xhdpi": "./assets/images/splash-frames/splash-frame@2x.png",
            "xxhdpi": "./assets/images/splash-frames/splash-frame@3x.png",
            "xxxhdpi": "./assets/images/splash-frames/splash-frame@3x.png",
            "resizeMode": "cover",
            "backgroundColor": "#BEC4B3"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "firebaseApiKey": "YOUR_FIREBASE_API_KEY",
      "firebaseAuthDomain": "YOUR_PROJECT.firebaseapp.com",
      "firebaseProjectId": "YOUR_FIREBASE_PROJECT_ID",
      "firebaseStorageBucket": "YOUR_PROJECT.firebasestorage.app",
      "firebaseMessagingSenderId": "YOUR_FIREBASE_MESSAGING_SENDER_ID",
      "firebaseAppId": "YOUR_FIREBASE_APP_ID",
      "firebaseMeasurementId": "YOUR_FIREBASE_MEASUREMENT_ID",
      "revenueCatApiKeyApple": "YOUR_REVENUECAT_APPLE_API_KEY",
      "revenueCatApiKeyGoogle": "YOUR_REVENUECAT_GOOGLE_API_KEY",
      "revenueCatEntitlementPro": "into_the_pond_pro",
      "revenueCatEntitlementWooden": "wooden_rod",
      "revenueCatEntitlementFiberglass": "fiberglass_rod",
      "revenueCatEntitlementLifetime": "lifetime_keeper",
      "cloudFunctionsRegion": "asia-east2",
      "eas": {
        "projectId": "d758a6d8-d626-40cc-8dae-f7e546f064dd"
      }
    }
  }
}
