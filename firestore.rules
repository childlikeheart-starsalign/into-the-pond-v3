rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Economy + progression — server-write only (Admin SDK / Cloud Functions).
    // Keep in sync with shared/firestore/economyFieldRegistry.ts
    function economyFieldKeys() {
      return [
        'totalWonder',
        'currentWonder',
        'storedWonder',
        'lifetimeWonderEarned',
        'lastReflectionAt',
        'inventory',
        'activeCast',
        'lastClaimedCastId',
        'fishingWonderToday',
        'lastFishingResetDate',
        'fishingPity',
        'castCancelRecentMs',
        'dailyQuestionCount',
        'lastQuestionResetDate',
        'activeRod',
        'rodDullnessCount',
        'isRodDull',
        'equippedRodId',
        'subscription',
        'completedLessons',
      ];
    }

    // Client-safe fields for users/{uid} create — keep in sync with economyFieldRegistry.ts
    function clientSafeUserCreateKeys() {
      return [
        'email',
        'hasSeenTutorial',
        'childArchetype',
        'hasCompletedDay1Narrative',
      ];
    }

    function economyFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(economyFieldKeys());
    }

    function hasOnlyClientSafeCreateFields(data) {
      return data.keys().hasOnly(clientSafeUserCreateKeys());
    }

    function clientProfileCreateAllowed(uid) {
      return false;
    }

    // Client-safe fields for users/{uid} update — keep in sync with economyFieldRegistry.ts
    function clientSafeUserUpdateKeys() {
      return [
        'email',
        'hasSeenTutorial',
        'hasCompletedEmailVerifiedCelebration',
        'childArchetype',
        'childBirthDate',
        'hasCompletedDay1Narrative',
        'narrativeProgress',
        'analyticsOptOut',
        // Keep `activeChildId` in this allow-list: Track A `clientSafeUpdateKeysOnly` denies
        // any key not listed. The child switcher writes this field from the client; dropping
        // it in a future rules cleanup would silently break switching (same class of bug as
        // omitting `children` from the catch-all read exclude).
        'activeChildId',
      ];
    }

    function clientSafeUpdateKeysOnly() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(clientSafeUserUpdateKeys());
    }


    // Parity with shared/childProfile/tierAccess.ts — childOrder 1 never gated by tier.
    function resolveAccountTier(subscription) {
      return subscription != null && subscription.isLifetime == true
        ? 'lifetime'
        : subscription != null && subscription.subscriptionStatus == 'wooden'
          ? 'wooden'
          : subscription != null && subscription.subscriptionStatus == 'fiberglass'
            ? 'fiberglass'
            : 'free';
    }

    function tierChildLimit(tier) {
      return tier == 'free' ? 1 : 3;
    }

    function canAccessChildOrder(childOrder, tier) {
      return childOrder == 1 || childOrder <= tierChildLimit(tier);
    }

    function ownerCanAccessChild(uid, childData) {
      return isOwner(uid)
        && childData.keys().hasAll(['childOrder'])
        && childData.childOrder is int
        && canAccessChildOrder(
          childData.childOrder,
          resolveAccountTier(get(/databases/$(database)/documents/users/$(uid)).data.subscription)
        );
    }

    function authFunnelFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authFunnel']);
    }

    function clientProfileUpdateAllowed(uid) {
      return isOwner(uid)
        && economyFieldsUnchanged()
        && authFunnelFieldsUnchanged()
        && clientSafeUpdateKeysOnly();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if clientProfileCreateAllowed(uid);
      allow update: if clientProfileUpdateAllowed(uid);
      allow delete: if false;

      // Offline sync + journal (server-write via callables / legacy functions).
      match /diaryEntries/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Fishing collection sync (server-write via claimEncounter).
      match /creatures/{creatureId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Legacy well Q&A cache (server-write only).
      match /wellQuestions/{questionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Well progression state — server-write-only (Cloud Functions).
      match /wellState/{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Child Atlas insights — immutable parent-authored records, server-write-only.
      match /childAtlas/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
        allow delete: if false;
      }

      // Rod progression — server-write-only (startCraft / collectCraft callables).
      match /playerRods/{rodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Wonder ledger — append-only, server-write-only (legacy dual-write during migration).
      match /wonderTransactions/{transactionId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Economy ledger — append-only, server-write-only (Admin SDK only).
      match /economyLedger/{entryId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Economy idempotency — server-write-only.
      match /economyIdempotency/{key} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Folded ledger prefix checkpoint — server-write-only (Invariant 7: ledger rows unchanged).
      match /economyLedgerCheckpoint/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Analytics + audit — server-write-only.
      match /sanctuaryAnalytics/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /fishingClaims/{claimId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /practiceCompletions/{completionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }


      // Multi-child profiles — server-write only; reads gated by childOrder + subscription.
      match /children/{childId} {
        allow read: if ownerCanAccessChild(uid, resource.data);
        allow create, update, delete: if false;

        match /wellState/{document=**} {
          allow read: if ownerCanAccessChild(
            uid,
            get(/databases/$(database)/documents/users/$(uid)/children/$(childId)).data
          );
          allow write: if false;
        }

        match /wellQuestions/{entryId} {
          allow read: if ownerCanAccessChild(
            uid,
            get(/databases/$(database)/documents/users/$(uid)/children/$(childId)).data
          );
          allow write: if false;
        }

        match /childAtlas/{entryId} {
          allow read: if ownerCanAccessChild(
            uid,
            get(/databases/$(database)/documents/users/$(uid)/children/$(childId)).data
          );
          allow write: if false;
          allow delete: if false;
        }
      }

      // Catch-all: deny client writes to any other subcollection under users/{uid}.
      // Exclude `children` from owner-read: Firestore ORs overlapping match results, so a
      // permissive catch-all would let free-tier owners read over-limit child docs.
      match /{subcollection}/{document=**} {
        allow read: if isOwner(uid) && subcollection != 'children';
        allow write: if false;
      }
    }

    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    function isEconomyAdmin() {
      return request.auth != null && request.auth.token.economyAdmin == true;
    }

    // Ops drift reports — economy admin read, server-write only.
    match /admin/{docId} {
      allow read: if isEconomyAdmin();
      allow write: if false;
    }

    // Account deletion backups — server-write-only (Admin SDK / Cloud Functions).
    match /deletion_requests/{uid} {
      allow read, write: if false;
    }

    match /deletion_web_tokens/{uid} {
      allow read, write: if false;
    }

    match /deletion_web_rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // Detached financial records at permanent purge — server-write-only.
    match /financialRecords/{recordId} {
      allow read, write: if false;
    }

    // Runtime feature flags (allowlist rollout) — server-write only.
    // Public read: signed-out Gate reads newOnboardingEnabled before auth (app/index.tsx).
    // Path: featureFlags/{flagName} — flag name is the document id.
    match /featureFlags/{flagName} {
      allow read: if true;
      allow write: if false;
    }

  }
}
