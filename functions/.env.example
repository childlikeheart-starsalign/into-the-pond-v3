# Copy to `.env.local` in this folder (`cp .env.example .env.local`). `.env.local` is gitignored
# and is NOT uploaded by `firebase deploy` (unlike `.env` / `.env.<projectId>`).
#
# Do NOT put FIREBASE_SERVICE_ACCOUNT_PATH in `functions/.env` — Firebase rejects keys with the
# FIREBASE_ prefix when packaging Cloud Functions env.
#
# Use an absolute path to your service account JSON (keep the file out of git).
# Example filename from Firebase: into-the-pond-firebase-adminsdk-fbsvc-*.json

FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/your-service-account.json

# Comma-separated UIDs allowed to call compensateEconomyEntry (or set firebase functions:config:set economy.admin_uids="uid1,uid2")
# ECONOMY_ADMIN_UIDS=

# When true, commitEconomyAction skips wonderTransactions dual-write (economyLedger only).
# Path A: set in committed functions/.env.into-the-pond (loaded on deploy for project into-the-pond).
# ECONOMY_LEDGER_ONLY=true

# AES key material for encrypted deletion restore payloads (32+ char secret).
# Put the real value in `.env.local` only (gitignored — not uploaded by firebase deploy).
# Deploy ritual for project into-the-pond:
#   1. Temporarily add ACCOUNT_DELETION_SECRET and ACCOUNT_DELETION_ENABLED=true to
#      `.env.into-the-pond` (do not commit).
#   2. Deploy the account-deletion functions.
#   3. Remove the secret from `.env.into-the-pond` and set ACCOUNT_DELETION_ENABLED=false
#      before committing. Runtime keeps last-deployed values until the next deploy.
# ACCOUNT_DELETION_SECRET=

# Fail-closed: deletion callables run only when this is exactly "true".
# ACCOUNT_DELETION_ENABLED=true

# Resend (web account-deletion confirmation emails). Keep in `.env.local`; inject into
# `.env.into-the-pond` only for deploy, then scrub before commit (same ritual as ACCOUNT_DELETION_SECRET).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Into the Pond <noreply@intothepond.app>
# Optional override for confirm links (default https://intothepond.app/delete-account)
# ACCOUNT_DELETION_CONFIRM_BASE_URL=https://intothepond.app/delete-account

# RevenueCat REST secret (server). Optional for cast/well; required for verifyPurchase / syncSubscriptionStatus.
# Prefer Secret Manager / EAS for production; may also live in .env.into-the-pond if you accept deploy packaging.
# REVENUECAT_SECRET_KEY=
# REVENUECAT_ENTITLEMENT_PRO=into_the_pond_pro
# REVENUECAT_ENTITLEMENT_WOODEN=wooden_rod
# REVENUECAT_ENTITLEMENT_FIBERGLASS=fiberglass_rod
# REVENUECAT_ENTITLEMENT_LIFETIME=lifetime_keeper
