# Copy to `.env` in this folder (`cp .env.example .env`). `.env` is gitignored.
#
# Use an absolute path to your service account JSON (keep the file out of git).
# Example filename from Firebase: into-the-pond-firebase-adminsdk-fbsvc-6d2d2e874b.json
#
# For `firebase deploy`, omit this variable / remove `.env` so Admin uses the default runtime credential only.

FIREBASE_SERVICE_ACCOUNT_PATH=/Users/hjcfung/Documents/into-the-pond-v3/functions/into-the-pond-firebase-adminsdk-fbsvc-5671b9f469.json

# Comma-separated UIDs allowed to call compensateEconomyEntry (or set firebase functions:config:set economy.admin_uids="uid1,uid2")
# ECONOMY_ADMIN_UIDS=

# When true, commitEconomyAction skips wonderTransactions dual-write (economyLedger only).
# Path A: set in committed functions/.env.into-the-pond (loaded on deploy for project into-the-pond).
# ECONOMY_LEDGER_ONLY=true

# AES key material for encrypted deletion restore payloads (32+ char secret).
# ACCOUNT_DELETION_SECRET=

# Set to false to disable account deletion callables (rollback switch).
# ACCOUNT_DELETION_ENABLED=true

