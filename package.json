{
  "name": "into-the-pond-v3",
  "version": "3.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/fix-simulator-scheme-plist.mjs && CHOKIDAR_USEPOLLING=1 WATCHPACK_POLLING=true expo start",
    "android": "node scripts/fix-simulator-scheme-plist.mjs && CHOKIDAR_USEPOLLING=1 WATCHPACK_POLLING=true expo run:android",
    "ios": "node scripts/fix-simulator-scheme-plist.mjs && node scripts/link-firebase-ios-plist.mjs && CHOKIDAR_USEPOLLING=1 WATCHPACK_POLLING=true expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android:sync-gradle": "cd android && ./gradlew --no-daemon projects",
    "verify": "tsc --noEmit",
    "verify:firebase-ios-native": "node scripts/verify-firebase-ios-native.mjs",
    "verify:firebase-rtdb-env": "node scripts/verify-firebase-rtdb-env.mjs",
    "verify:no-firebase-secrets": "node scripts/verify-no-firebase-secrets.mjs",
    "deploy:database-rules": "node scripts/check-firebase-cli-auth.mjs && npx firebase-tools deploy --only database",
    "deploy:check-sign-in-email": "node scripts/check-firebase-cli-auth.mjs && npx firebase-tools deploy --only functions:checkSignInEmailRegistered",
    "deploy:h5-c8": "node scripts/check-firebase-cli-auth.mjs && npx firebase-tools deploy --only functions,firestore:rules,firestore:indexes",
    "firebase:login": "npx firebase-tools login",
    "firebase:whoami": "npx firebase-tools login:list",
    "setup:eas-rtdb-env": "node scripts/setup-eas-rtdb-env.mjs",
    "setup:eas-firebase-files": "node scripts/setup-eas-firebase-files.mjs",
    "write:firebase-native-files": "node scripts/write-firebase-native-files.mjs",
    "eas": "eas",
    "eas:login": "eas login",
    "eas:whoami": "eas whoami",
    "eas:build": "eas build",
    "eas:update": "eas update",
    "eas:build:development": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production --platform all",
    "generate:well-catalog": "python3 scripts/generate_well_catalog.py",
    "generate:atlas-entry-cards": "python3 scripts/extract_atlas_entry_cards.py",
    "extract:well-birthdate-assets": "python3 scripts/extract_well_birthdate_assets.py",
    "bake:well-scene-gradients": "node scripts/bake_well_scene_gradients.js",
    "bake:todays-focus-card-shell": "node scripts/bake_todays_focus_card_shell.js",
    "trim:todays-focus-card": "node scripts/trim_todays_focus_card.js",
    "test:well": "npx tsx scripts/run-well-self-test.ts",
    "test:rod-progression": "npx tsx scripts/run-rod-progression-self-test.ts",
    "test:birth-date": "npx tsx scripts/run-birth-date-self-test.ts",
    "test:well-birthdate-merge": "npx tsx scripts/run-well-birthdate-merge-self-test.ts",
    "test:auth-resolver": "npx tsx scripts/run-auth-resolver-self-test.ts",
    "test:sign-in-classification": "npx tsx scripts/run-sign-in-classification-self-test.ts",
    "test:sign-in-arrival": "npx tsx scripts/run-sign-in-arrival-self-test.ts",
    "test:sanctuary-readiness": "npx tsx scripts/run-sanctuary-readiness-self-test.ts",
    "test:curtain-lift-prefetch": "npx tsx scripts/run-curtain-lift-prefetch-self-test.ts",
    "test:firestore-rules": "node scripts/run-firestore-rules-test.mjs",
    "test:auth-links": "npx tsx --test tests/authLinks.test.ts",
    "auth:transparent-black": "node scripts/auth-black-to-transparent.mjs",
    "extract:gate-key-sprite": "node scripts/extract-gate-key-sprite.mjs",
    "process:rod-collection-assets": "node scripts/process-rod-collection-assets.js",
    "git:snapshot": "node scripts/create-git-snapshot.mjs",
    "git:commit-tracked": "node scripts/git-commit-tracked.mjs",
    "lint": "eslint .",
    "lint:economy": "eslint src --rule 'local/no-client-economy-writes: error' --rule 'local/no-client-claim-formulas: error' --rule 'local/no-client-reward-computation: error' --rule 'local/no-legacy-cast-claim: error' && node scripts/test-eslint-economy-rules.mjs && node scripts/test-fishing-claim-invariant8.mjs && node scripts/test-fishing-claim-invariant10.mjs && node functions/scripts/validate-invariant10-fishing-claim.mjs",
    "backfill:economy-ledger": "npm run backfill:economy-ledger --prefix functions",
    "backfill:economy-ledger:commit": "npm run backfill:economy-ledger:commit --prefix functions",
    "smoke:economy-phase0": "npm run smoke:economy-phase0 --prefix functions",
    "smoke:economy-phase0:probe": "npm run smoke:economy-phase0:probe --prefix functions",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "^2.6.2",
    "expo": "^54.0.1",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "posthog-react-native": "^4.50.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.0.1",
    "react-native-purchases-ui": "^10.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "overrides": {
    "@nozbe/watermelondb": {
      "@babel/runtime": "^7.26.10"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dotenv": "^16.4.5",
    "eas-cli": "^20.4.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "firebase": "^12.15.0",
    "firebase-tools": "^15.22.3",
    "husky": "^9.1.7",
    "ignore": "^7.0.5",
    "isomorphic-git": "^1.37.6",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
